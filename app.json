{
  "expo": {
    "name": "Tru",
    "slug": "tru",
    "scheme": "tru",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#171717",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tru.news"
    },
    "android": {
      "package": "com.tru.news",
      "allowBackup": false,
      "backgroundColor": "#171717",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-foreground.png",
        "backgroundColor": "#171717"
      },
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "backgroundColor": "#171717",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/splash.png",
            "backgroundColor": "#171717"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "description": "Find the facts. Keep your privacy. Free news, original sources and optional source-backed AI. No subscription or Tru telemetry."
  }
}
