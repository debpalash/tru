# Server-only credentials. Copy to .env; never distribute this file with values.
# The mobile app connects through Settings and never reads provider keys.
GOOGLE_AI_API_KEY=
GOOGLE_AI_MODEL=gemini-flash-lite-latest
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3.8-27b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
FIRECRAWL_API_KEY=
PORT=8788
# Comma-separated provider IDs to hide from clients and reject at the server.
TRU_DISABLED_PROVIDERS=
# Keep localhost for a direct host install; containers set their own bind address.
TRU_LISTEN_HOST=127.0.0.1
TRU_DATA_DIR=.local
